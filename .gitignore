# Never commit credentials, secrets, or API keys
client_secret_*.json
*.pem
*.key
.env
.env.*
*secrets*/

# Store packages built by publish workflows / manual packaging — not source
*.zip

# Store listing screenshots/promo assets — not part of the extension source
assets/screenshots/chrome-store/
firefox-addons/Screenshots/

# Stray/unidentified files
/unnamed.png
